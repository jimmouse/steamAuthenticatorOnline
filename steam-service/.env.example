# Steam Service Configuration

# 服务端口
PORT=3020

# API密钥（用于主系统调用此服务）
API_SECRET=your-secure-api-secret-here

# 允许的来源（主系统地址）
ALLOWED_ORIGINS=http://localhost:3010,http://localhost:8081

# Session存储路径
SESSION_STORAGE_PATH=./data/sessions

# 日志级别
LOG_LEVEL=info

# Steam API配置
STEAM_WEB_API_KEY=your-steam-web-api-key
