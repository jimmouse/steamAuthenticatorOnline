# ==================== 主系统配置 ====================

# JWT密钥 - 请修改为强随机字符串
JWT_SECRET=your-very-secure-random-string-here

# JWT过期时间
JWT_EXPIRES_IN=24h

# 服务器端口
PORT=3010
BACKEND_PORT=3010
FRONTEND_PORT=8081

# 运行环境
NODE_ENV=production

# 是否信任代理（如果使用Nginx等反向代理，设置为true）
TRUST_PROXY=false

# IP头部字段（如果TRUST_PROXY=true）
IP_HEADER=x-forwarded-for

# ==================== Steam托管服务配置 ====================

# Steam服务端口
STEAM_SERVICE_PORT=3020

# Steam服务API密钥（主系统和Steam服务共用）
STEAM_SERVICE_API_SECRET=change-this-to-a-secure-random-string

# Steam Web API Key（可选，用于某些Steam API调用）
STEAM_WEB_API_KEY=

# 日志级别
LOG_LEVEL=info

# ==================== Docker配置 ====================

# Compose项目名称
COMPOSE_PROJECT_NAME=steam-authenticator

# 数据持久化路径（可选，默认使用Docker volumes）
# DATA_PATH=./data
